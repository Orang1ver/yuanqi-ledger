{
  "name": "yuanqi-ledger",
  "version": "1.1.1",
  "private": true,
  "description": "元气账本 —— 记录吃、喝、动、睡的个人健康账本",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check:data": "node scripts/run-ts.mjs scripts/check-data-continuity.ts",
    "check:nutrition": "node scripts/check-nutrition.mjs",
    "check:reference": "node scripts/check-food-reference.mjs",
    "check:chunks": "node scripts/check-page-chunks.mjs",
    "test": "node scripts/run-ts.mjs lib/nutrition/core.test.ts lib/nutrition/analysis.test.ts lib/nutrition/menu.test.ts lib/nutrition/recommend.test.ts lib/nutrition/tiers.test.ts lib/ai/recommend.test.ts lib/ai/feedback.test.ts lib/storage/diet.test.ts lib/storage/backupReminder.test.ts lib/storage/backup.test.ts lib/copy.test.ts lib/mealPresets.test.ts lib/wellness.test.ts lib/weight.test.ts lib/update.test.ts --test",
    "probe": "node scripts/run-ts.mjs scripts/nutrition-probe.ts --",
    "preview": "node scripts/preview.mjs",
    "smoke": "node scripts/browser-smoke.mjs",
    "demo:data": "node scripts/make-demo-backup.mjs",
    "icons": "python scripts/make-icons.py",
    "android:apk": "powershell -ExecutionPolicy Bypass -File scripts/android/build-apk.ps1"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/browser": "^7.0.5",
    "@capacitor/core": "^7.6.9",
    "canvas-confetti": "^1.9.4",
    "motion": "^13.2.0",
    "next": "16.2.9",
    "openai": "^6.7.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.9",
    "@tailwindcss/postcss": "^4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
