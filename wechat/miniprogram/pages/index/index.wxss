.brand { display: flex; align-items: center; margin-bottom: 32rpx; }
.avatar { width: 104rpx; height: 104rpx; flex-shrink: 0; border-radius: 24rpx; margin-right: 24rpx; }
.brand-copy { flex: 1; min-width: 0; }
.name { font-size: 38rpx; font-weight: 600; line-height: 1.4; margin-bottom: 8rpx; }
.hint + .hint { margin-top: 16rpx; }
.status { padding-top: 20rpx; font-size: 32rpx; line-height: 1.7; }
.day { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 16rpx; padding: 20rpx 0; border-bottom: 1rpx solid var(--yq-border); }
.day:last-child { border-bottom: none; }
.revoke { margin-top: 28rpx; }
