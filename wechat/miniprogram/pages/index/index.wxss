page { background: #f7f8f4; color: #25352b; }
.page { padding: 48rpx 32rpx; }
.title { font-size: 42rpx; font-weight: 600; margin-bottom: 24rpx; }
.hint { color: #657168; font-size: 27rpx; line-height: 1.8; margin: 24rpx 0; }
button { margin: 20rpx 0; }
button[type=primary] { background: #367858; }
.status { font-size: 28rpx; line-height: 1.7; margin: 24rpx 0; }
.day { display: flex; justify-content: space-between; padding: 18rpx 0; border-bottom: 1rpx solid #dce3dc; }
