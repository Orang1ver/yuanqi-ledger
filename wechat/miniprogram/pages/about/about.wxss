.intro { text-align: center; margin-bottom: 32rpx; }
.avatar { width: 144rpx; height: 144rpx; border-radius: 32rpx; margin-bottom: 16rpx; }
.name { font-size: 40rpx; font-weight: 600; margin-bottom: 16rpx; }
.step { display: flex; margin: 20rpx 0; }
.number { display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 48rpx; height: 48rpx; border-radius: 50%; background: var(--yq-primary); color: #ffffff; font-size: 28rpx; margin-right: 16rpx; margin-top: 4rpx; }
.question { font-weight: 600; margin-top: 24rpx; margin-bottom: 8rpx; }
.hint + .hint { margin-top: 16rpx; }
.section-title + view + .hint { margin-top: 16rpx; }
.url { color: var(--yq-muted); font-size: 28rpx; overflow-wrap: anywhere; word-break: break-all; }
.email { overflow-wrap: anywhere; word-break: break-all; margin-top: 8rpx; }
