page {
  --yq-background: #f7f8f4;
  --yq-surface: #ffffff;
  --yq-text: #25352b;
  --yq-muted: #536157;
  --yq-primary: #2c7b64;
  --yq-border: #dce3dc;
  background: var(--yq-background);
  color: var(--yq-text);
  font-size: 32rpx;
  line-height: 1.7;
}
.page { padding: 40rpx 32rpx calc(40rpx + env(safe-area-inset-bottom)); }
.card { background: var(--yq-surface); border: 1rpx solid var(--yq-border); border-radius: 24rpx; padding: 28rpx; margin-bottom: 24rpx; }
.section-title { font-size: 34rpx; font-weight: 600; margin-bottom: 16rpx; }
.hint { color: var(--yq-muted); font-size: 30rpx; line-height: 1.8; }
button { min-height: 96rpx; display: flex; align-items: center; justify-content: center; margin: 20rpx 0; padding: 16rpx 24rpx; font-size: 32rpx; line-height: 1.5; border-radius: 16rpx; background: var(--yq-surface); color: var(--yq-text); white-space: normal; }
button[type=primary] { background: var(--yq-primary); color: #ffffff; }
button[disabled] { background: #e8ede8; color: var(--yq-muted); }
button::after { border: 1rpx solid var(--yq-border); border-radius: 16rpx; }
button[type=primary]::after { border: none; }
