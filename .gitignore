# dependencies
/node_modules
/.pnp
.pnp.*

# next.js
/.next/
/out/

# 数据延续自检的临时编译产物（npm run check:data）
/.tmp-check/

# 浏览器冒烟测试的截图（npm run smoke）
/.tmp-smoke/

# 演示用样例数据备份（npm run demo:data）
/.tmp-demo/

# 兜底：临时文件一律别提交。
# 加这条是因为真出过一次 —— 提交前顺手 `git add -A`，把写 commit message 用的
# `.tmp-commit-msg.txt` 一起提交了（0.13.0 里带上了一个 40 行的垃圾文件）。
/.tmp-*

# 打好的安卓包（scripts/android/build-apk.ps1 的产物，属于构建输出不是源码）
/dist/

# Python 的字节码缓存（scripts/*.py 被 import 一次就会生成）
__pycache__/
*.pyc

next-env.d.ts
*.tsbuildinfo

# production
/build

# misc
.DS_Store
*.pem
Thumbs.db

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo

# editor
.vscode/*
!.vscode/extensions.json
.idea
